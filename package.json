{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/postbuild-gh-pages.mjs",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "doctor": "npx react-doctor@latest"
  },
  "dependencies": {
    "@emailjs/browser": "^4.4.1",
    "@vercel/analytics": "^2.0.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "framer-motion": "^12.42.0",
    "lucide-react": "^1.21.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet-async": "^3.0.0",
    "react-hot-toast": "^2.6.0",
    "react-router-dom": "^7.18.0",
    "tailwind-merge": "^3.6.0",
    "vite-plugin-pwa": "^1.3.0"
  },
  "reactDoctor": {
    "rules": {
      "require-reduced-motion": "off",
      "no-gray-on-colored-background": "off",
      "prefer-module-scope-pure-function": "off",
      "no-giant-component": "off",
      "no-multi-comp": "off",
      "only-export-components": "off",
      "client-localstorage-no-version": "off",
      "no-long-transition-duration": "off",
      "no-inline-bounce-easing": "off",
      "prefer-useReducer": "off",
      "jsx-no-jsx-as-prop": "off",
      "js-flatmap-filter": "off"
    }
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.1",
    "@vitejs/plugin-react": "^6.0.2",
    "autoprefixer": "^10.5.2",
    "oxlint": "^1.69.0",
    "postcss": "^8.5.15",
    "tailwindcss": "^4.3.1",
    "vite": "^8.1.0",
    "vite-plugin-sitemap": "^0.8.2",
    "vitest": "^4.1.9"
  }
}
